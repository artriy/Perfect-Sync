{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Perfect Sync",
  "version": "0.1.7",
  "identifier": "com.artriy.perfectsync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Perfect Sync",
        "width": 1120,
        "height": 720,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://storage.googleapis.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://storage.googleapis.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "copyright": "© artriy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["perfectsync"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQjM1MzgxRTI1QkI0M0EKUldRNnRGdmlnVk96N1RXVHkxWVJMVGxKdjhkOG11NWlYWkxuV0VyWGpZbGJER2VhWHdqcHpNc0YK",
      "endpoints": [
        "https://github.com/artriy/Perfect-Sync/releases/latest/download/latest.json"
      ]
    }
  }
}
